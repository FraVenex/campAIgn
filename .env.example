# Copia in .env e compila con i valori del tuo progetto (non committare .env)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<chiave-anon-pubblica>

# Secret della Edge Function `arnaldo` (supabase secrets set GEMINI_API_KEY=...)
GEMINI_API_KEY=<chiave-gemini>
GEMINI_MODEL=gemini-2.5-flash
